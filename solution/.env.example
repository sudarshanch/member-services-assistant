# Copy to solution/.env and fill in the key. .env is gitignored.

# deterministic = local policy. This is what the evaluation gate runs.
# openai = a real tool-calling model on any OpenAI-compatible API.
MODEL_PROVIDER=openai

# Gemini. For OpenAI itself, use https://api.openai.com/v1 and a gpt model name.
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MODEL_NAME=gemini-3.8-flash
OPENAI_API_KEY=

# Member, claims, grievance, and directory APIs. The model calls tools.
# These APIs stay the system of record. For this assignment they are the pack mock.
# MOCK_BASE_URL=http://127.0.0.1:8090
# PACK_DIR=
